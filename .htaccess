# Used when the project folder itself is the web root (e.g. XAMPP htdocs/taikon_motorparts).
# Routes every request into /public so app code, config and .env are never reachable.
# In production, point your virtual host's DocumentRoot at /public instead.

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^$ public/ [L]
    RewriteCond %{REQUEST_URI} !/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^\.env">
    Require all denied
</FilesMatch>
