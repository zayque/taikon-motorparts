# ------------------------------------------------------------------
# Taikon Motorparts — environment configuration
# Copy this file to `.env` and adjust for each environment.
# Never commit your real `.env`.
# ------------------------------------------------------------------

APP_NAME="Taikon Motorparts"
# local | production
APP_ENV=local
# true shows detailed errors. Always false in production.
APP_DEBUG=true
# Leave empty to auto-detect (works for both `php -S` and XAMPP sub-folders).
# Set explicitly in production, e.g. https://taikonmotorparts.com
APP_URL=
APP_TIMEZONE=Asia/Kuala_Lumpur

# Database runs in Docker: `docker compose up -d` (see docker-compose.yml)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=taikon_motorparts
DB_USERNAME=taikon
DB_PASSWORD=taikon_secret
# Only used by docker-compose to set the MySQL root password.
DB_ROOT_PASSWORD=root_secret

# Set to true when served over HTTPS so session cookies are marked Secure.
SESSION_SECURE=false
